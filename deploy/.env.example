# Copy to .env and edit.

# ---------------------------------------------------------------------------
# REQUIRED: where the collector forwards metrics.
# Base URL only -- the collector appends /opentelemetry/v1/metrics itself.
#
#   using the bundled VictoriaMetrics:
VM_OTLP_BASE_URL=http://victoriametrics:8428
#   using an existing instance:
# VM_OTLP_BASE_URL=https://vm.example.lan
# ---------------------------------------------------------------------------

# Port the collector listens on for Proxmox's OTLP/HTTP pushes.
# This is what you put in the Proxmox metric server's "Port" field.
# The default accepts LAN connections; restrict it to trusted Proxmox nodes
# with the host firewall.
OTEL_BIND_ADDRESS=0.0.0.0
OTEL_HTTP_PORT=4318
OTEL_MEMORY_LIMIT=512m

# Keep the bundled UI, query API, and diagnostics private on the Docker host.
LOCAL_BIND_ADDRESS=127.0.0.1

# debug | info | warn | error. Use debug to see individual push payloads.
OTEL_LOG_LEVEL=info

# --- bundled VictoriaMetrics and Grafana ---------------------------------
VM_PORT=8428
VM_RETENTION=1y
# Keep this aligned with the datasource timeInterval setting.
VM_DEDUP=30s

GRAFANA_PORT=3000
# Use 0.0.0.0 for easy access from your trusted LAN. Protect this port with
# the Docker host firewall; never expose it directly to the internet.
GRAFANA_BIND_ADDRESS=0.0.0.0
GRAFANA_USER=admin
GRAFANA_PASSWORD=replace-with-a-strong-local-password

# Datasource URL Grafana is provisioned with. Defaults to the bundled
# VictoriaMetrics. Point it at an existing backend if you do not want Grafana
# to query the bundled instance:
#   VM_DATASOURCE_URL=https://vm.example.lan
VM_DATASOURCE_URL=http://victoriametrics:8428
