        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "Storage Utilisation",
          "description": "Used share per configured storage. Includes shared/remote storages, so totals can exceed local disk.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${DS_PROMETHEUS}"
                      },
                      "spec": {
                        "expr": "proxmox_storage_used{node=~\"$node\"} / proxmox_storage_total{node=~\"$node\"}",
                        "interval": "30s",
                        "legendFormat": "{{storage}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "interval": "30s"
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "bargauge",
            "version": "13.1.1",
            "spec": {
              "options": {
                "displayMode": "lcd",
                "legend": {
                  "calcs": [],
                  "displayMode": "list",
                  "overflow": "ellipsis",
                  "placement": "bottom",
                  "showLegend": false
                },
                "maxVizHeight": 300,
                "minVizHeight": 16,
                "minVizWidth": 8,
                "namePlacement": "left",
                "orientation": "horizontal",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "limit": 12,
                  "values": false
                },
                "showUnfilled": false,
                "sizing": "auto",
                "valueMode": "color"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "percentunit",
                  "decimals": 1,
                  "min": 0,
                  "max": 1,
                  "mappings": [
                    {
                      "type": "special",
                      "options": {
                        "match": "null",
                        "result": {
                          "text": "No data",
                          "color": "#808080",
                          "index": 91
                        }
                      }
                    },
                    {
                      "type": "special",
                      "options": {
                        "match": "nan",
                        "result": {
                          "text": "n/a",
                          "color": "#808080",
                          "index": 90
                        }
                      }
                    }
                  ],
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "#808080"
                      },
                      {
                        "value": 1e-12,
                        "color": "green"
                      },
                      {
                        "value": 0.75,
                        "color": "#E0B400"
                      },
                      {
                        "value": 0.9,
                        "color": "#F2495C"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-9": {
        "kind": "Panel",
        "spec": {
          "id": 9,
          "title": "Guest Power State",
          "description": "Running (1) vs stopped (0) per guest over time. Derived from uptime because Proxmox emits no status metric. Templates show as permanently stopped.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${DS_PROMETHEUS}"
                      },
                      "spec": {
                        "expr": "clamp_max(proxmox_vm_uptime{node=~\"$node\"}, 1)",
                        "interval": "30s",
                        "legendFormat": "{{vmid}} {{name}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "interval": "30s"
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "state-timeline",
            "version": "13.1.1",
            "spec": {
              "options": {
                "alignValue": "center",
                "annotations": {
                  "clustering": -1,
                  "multiLane": false
                },
                "legend": {
                  "calcs": [],
                  "displayMode": "list",
                  "overflow": "ellipsis",
                  "placement": "bottom",
                  "showLegend": true
                },
                "mergeValues": true,
                "rowHeight": 0.9,
                "showValue": "always",
                "tooltip": {
                  "hideZeros": false,
                  "mode": "single",
                  "sort": "none"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "mappings": [
                    {
                      "type": "value",
                      "options": {
                        "0": {
                          "text": "Stopped",
                          "color": "text",
                          "index": 1
                        },
                        "1": {
                          "text": "Running",
                          "color": "green",
                          "index": 0
                        }
                      }
                    }
                  ],
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      },
                      {
                        "value": 80,
                        "color": "red"
                      }
                    ]
                  },
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "axisPlacement": "auto",
                    "fillOpacity": 85,
                    "hideFrom": {
                      "legend": false,
                      "tooltip": false,
                      "viz": false
                    },
                    "insertNulls": false,
                    "lineWidth": 0,
                    "spanNulls": false
                  }
                },
                "overrides": []
              }
            }
          }
        }
      }
